+/* Preserve the full unsigned range of an undo location in SQL. */
+static Datum
+undo_location_to_numeric_datum(UndoLocation location)
+{
+	char		buf[21];
+
+	snprintf(buf, sizeof(buf), UINT64_FORMAT, (uint64) location);
+	return DirectFunctionCall3(numeric_in,
+							   CStringGetDatum(buf),
+							   ObjectIdGetDatum(InvalidOid),
+							   Int32GetDatum(-1));
+}
+
+Datum
+orioledb_undo_buffer_stats(PG_FUNCTION_ARGS)
+{
+	ReturnSetInfo *rsinfo = (ReturnSetInfo *) fcinfo->resultinfo;
+
+	orioledb_check_shmem();
+	InitMaterializedSRF(fcinfo, 0);
+
+	for (int i = 0; i < (int) UndoLogsCount; i++)
+	{
+		UndoLogType undoType = (UndoLogType) i;
+		UndoMeta   *meta = get_undo_meta_by_type(undoType);
+		UndoLocation lastUsed,
+					written;
+		Datum		values[4];
+		bool		nulls[4] = {false};
+
+		/* These reads do not form a consistent snapshot. */
+		lastUsed = pg_atomic_read_u64(&meta->lastUsedLocation);
+		written = pg_atomic_read_u64(&meta->writtenLocation);
+
+		values[0] = CStringGetTextDatum(get_undo_type_name(undoType));
+		values[1] = Int64GetDatum((int64) o_undo_circular_sizes[i]);
+		values[2] = undo_location_to_numeric_datum(lastUsed);
+		values[3] = undo_location_to_numeric_datum(written);
+		tuplestore_putvalues(rsinfo->setResult, rsinfo->setDesc, values, nulls);
+	}
+
+	return (Datum) 0;
+}
+
 Datum
 orioledb_get_proc_retain_undo_locations(PG_FUNCTION_ARGS)
 {
