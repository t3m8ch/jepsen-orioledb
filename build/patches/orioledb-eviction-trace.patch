+				else
+				{
+					Assert(pool == get_ppool(OPagePoolCatalog));
+					poolName = "catalog";
+				}
+				elog(DEBUG1, "orioledb_trace event=%s pool=%s candidate_blkno=" UINT64_FORMAT,
+					 result == OWalkPageEvicted ? "btree_evict" :
+					 "btree_writeback",
+					 poolName, blkno);
+			}
 			break;
 		}
 		Assert(!have_locked_pages());
